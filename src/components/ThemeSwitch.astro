---
const themes = [
  { id: 'amber', label: 'amber crt' },
  { id: 'tranquility', label: 'tranquility' },
  { id: 'isthisit', label: 'is this it' },
];
---

<div class='theme-switch profile-card' data-label='THEME'>
  {
    themes.map((t) => (
      <button class='theme-btn' data-theme={t.id}>
        {t.label}
      </button>
    ))
  }
</div>

<script>
  const moodColors = {
    amber: { fg: 'ff8c00', bg: '050400' },
    tranquility: { fg: 'c8b090', bg: '050403' },
    isthisit: { fg: '8a7a6a', bg: 'f0ebe0' },
  } as const;

  type Theme = keyof typeof moodColors;

  function updateMoodImg(theme: Theme) {
    const { fg, bg } = moodColors[theme];
    const moodImg = document.getElementById('mood-img') as HTMLImageElement;
    if (moodImg) {
      moodImg.src = `https://moods.imood.com/display/uname-ai77ee/fg-${fg}/bg-${bg}/imood.gif`;
    }
  }

  function updateButtons(active: string) {
    document.querySelectorAll('.theme-btn').forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-theme') === active);
    });
  }

  function initTheme() {
    const saved = (localStorage.getItem('theme') || 'amber') as Theme;
    document.documentElement.setAttribute('data-theme', saved);
    updateButtons(saved);
    updateMoodImg(saved);
  }

  function initButtons() {
    // clona para limpiar listeners anteriores
    document.querySelectorAll('.theme-btn').forEach((btn) => {
      const newBtn = btn.cloneNode(true) as Element;
      btn.replaceWith(newBtn);

      newBtn.addEventListener('click', () => {
        const theme = (newBtn.getAttribute('data-theme') || 'amber') as Theme;
        localStorage.setItem('theme', theme);
        document.documentElement.setAttribute('data-theme', theme);
        updateButtons(theme);
        updateMoodImg(theme);
      });
    });
  }

  initTheme();
  initButtons();
  document.addEventListener('astro:page-load', () => {
    initTheme();
    initButtons();
  });
</script>

<style>
  .theme-switch {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .theme-btn {
    background: none;
    border: 1px solid var(--amber-dim);
    color: var(--amber-dim);
    font-family: var(--font-share-tech-mono), monospace;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    padding: 3px 8px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .theme-btn:hover {
    color: var(--amber);
    border-color: var(--amber);
  }

  .theme-btn.active {
    color: var(--bg);
    background: var(--amber);
    border-color: var(--amber);
  }
</style>
