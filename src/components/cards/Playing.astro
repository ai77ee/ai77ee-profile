---

<div id='song-widget' class='profile-card playing' data-label='LAST PLAYED'>
  <div class='song-info'>
    <img
      id='song-cover'
      src={CD_SVG}
      alt='Album cover'
      width='100'
      height='100'
    />
    <div class='song-text'>
      <a id='song-title-url' href='#' target='_blank' rel='noopener noreferrer'
        ><p id='song-title'>Loading...</p></a
      >
      <p id='song-artist'></p>
    </div>
  </div>
  <div class='listening-status'>
    <span id='song-status-dot'></span>
    <span id='song-status'></span>
  </div>
</div>

<script>
  function formatLastPlayed(timestamp: number): string {
    // from https://dev.to/natclark/calculating-relative-time-in-javascript-94p
    const date = new Date();
    const todayDate = date.getTime();
    const seconds = Math.floor(todayDate / 1000);

    const difference = seconds - timestamp;

    let output = ``;
    if (difference < 60) {
      // Less than a minute has passed:
      output = `${difference} seconds ago`;
    } else if (difference < 3600) {
      // Less than an hour has passed:
      output = `${Math.floor(difference / 60)} minutes ago`;
    } else if (difference < 86400) {
      // Less than a day has passed:
      output = `${Math.floor(difference / 3600)} hours ago`;
    } else if (difference < 2620800) {
      // Less than a month has passed:
      output = `${Math.floor(difference / 86400)} days ago`;
    } else if (difference < 31449600) {
      // Less than a year has passed:
      output = `${Math.floor(difference / 2620800)} months ago`;
    } else {
      // More than a year has passed:
      output = `${Math.floor(difference / 31449600)} years ago`;
    }
    return output;
  }

  const formatTime = (timestamp: number, timezone?: string) => {
    const date = new Date(timestamp * 1000);
    const diff = Math.floor(Date.now() / 1000) - timestamp;
    const currentTimestamp = Date.now(); // Today

    if (diff < 86400) {
      // less than 24h, show time only  <p class='p-right'>『what am i listening to?』</p>
      return date.toLocaleTimeString('en-US', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
        timeZone: timezone,
      });
    }

    // more than 24h, show date and time
    return date.toLocaleDateString('en-US', {
      weekday: diff < 86400 * 7 ? 'long' : undefined, // this week: day of the week, otherwise: date
      day: diff >= 86400 * 7 ? 'numeric' : undefined, // more than a week → date
      month: diff >= 86400 * 7 ? 'short' : undefined, // more than a week → month
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: timezone,
    });
  };

  const fetchAndUpdate = async () => {
    const res = await fetch('https://song-status.ai77ee.xyz/', {
      cache: 'no-store',
    });
    const data = await res.json();
    const dot = document.getElementById('song-status-dot')!;

    const coverImg = document.getElementById('song-cover') as HTMLImageElement;
    coverImg!.src = data.image || coverImg!.src;
    (document.getElementById('song-title-url') as HTMLAnchorElement)!.href =
      data.song_url || '#';
    document.getElementById('song-title')!.textContent = `「${data.song}」`;
    document.getElementById('song-artist')!.textContent = data.artist;
    //document.getElementById('song-status')!.textContent = data.listening
    //  ? 'currently listening'「」
    // : getRelativeTime(data.timestamp);
    console.log(data.timestamp);
    if (!data.listening) {
      dot.className = 'dot--inactive';
      const Time = formatLastPlayed(data.timestamp); // hora

      document.getElementById('song-status')!.textContent = `${Time}`;
    } else {
      dot.className = 'dot--active';
      document.getElementById('song-status')!.textContent = 'now listening';
    }
  };

  fetchAndUpdate();
  setInterval(fetchAndUpdate, 10000);
</script>
<style>
  @media (max-width: 600px) {
    .song-info {
      align-items: center;
      margin-bottom: 5px;
    }
    .song-text {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 4px; /* reduce el gap */
    }
    #song-cover {
      width: 32px;
      height: auto;
    }
    #song-status-dot {
      font-size: 0.7rem;
    }
    #song-status {
      font-size: 0.7rem;
    }
    #song-title,
    #song-artist {
      width: auto;
      max-width: 150px;
    }
  }
</style>
