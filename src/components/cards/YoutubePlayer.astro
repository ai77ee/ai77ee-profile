---
interface Props {
  videoId: string;
  title?: string;
}

const { videoId, title = 'VIDEO_FEED' } = Astro.props;
const embedUrl = `https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1`;
---

<div class='yt-player'>
  <div class='yt-header'>
    <span class='yt-tag'>VIDEO</span>
    <span class='yt-title'>{title}</span>
    <span class='yt-id'>ID: {videoId}</span>
  </div>

  <div class='yt-screen'>
    <iframe
      src={embedUrl}
      title={title}
      allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
      allowfullscreen></iframe>
    <!-- SCANLINES -->
    <div class='yt-overlay' aria-hidden='true'></div>
  </div>

  <div class='yt-footer'>
    <span>SRC: YOUTUBE.COM</span>
    <span>I LOVE THIS SONG!</span>
  </div>
</div>

<style>
  .yt-player {
    border: 1px solid var(--amber-dim, #a35500);
    background: var(--amber-faint, rgba(255, 140, 0, 0.05));
    margin-bottom: 25px;
    position: relative;
    font-family: var(--font-share-tech-mono), monospace;
  }

  /* esquinas decorativas */
  .yt-player::before,
  .yt-player::after {
    content: '';
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--amber, #ff8c00);
    border-style: solid;
    z-index: 1;
    pointer-events: none;
  }
  .yt-player::before {
    top: -1px;
    left: -1px;
    border-width: 2px 0 0 2px;
  }
  .yt-player::after {
    bottom: -1px;
    right: -1px;
    border-width: 0 2px 2px 0;
  }

  .yt-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 10px;
    border-bottom: 1px solid var(--amber-dim, #a35500);
    font-family: var(--font-share-tech-mono), monospace;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
  }

  .yt-tag {
    background: var(--amber, #ff8c00);
    color: #000;
    font-weight: bold;
    padding: 1px 6px;
    font-size: 0.55rem;
  }

  .yt-title {
    color: var(--amber, #ff8c00);
    flex: 1;
  }

  .yt-id {
    color: var(--amber-dim, #a35500);
  }

  /* contenedor del iframe con aspect ratio 16:9 */
  .yt-screen {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .yt-screen iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* scanlines encima del video */
  .yt-overlay {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(0, 0, 0, 0.08) 3px,
      rgba(0, 0, 0, 0.08) 4px
    );
    pointer-events: none;
  }

  .yt-footer {
    display: flex;
    justify-content: space-between;
    padding: 4px 10px;
    border-top: 1px solid var(--amber-dim, #a35500);
    font-family: var(--font-share-tech-mono), monospace;
    font-size: 0.55rem;
    letter-spacing: 0.12em;
    color: var(--amber-dim, #a35500);
  }
</style>
