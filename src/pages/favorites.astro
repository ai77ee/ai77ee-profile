---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
import ListCard from '../components/cards/ListCard.astro';
import MiniPlayer from '../components/cards/MiniPlayer.astro';

const songs = [
  {
    title: 'Square Wave',
    artist: 'The Voidz',
    youtubeId: 'n8-08vmrHHY',
    image:
      'https://lastfm-img.freetls.fastly.net/i/u/174s/2251d1e418066a0fadc187b68e2d05b7.jpg',
  },
  {
    title: 'Lonely in the Future',
    artist: 'The Strokes',
    youtubeId: 'uF85MlVtCKM',
    image:
      'https://lastfm-img.freetls.fastly.net/i/u/174s/86e66c508b9644b0cf80e97439ae2ccd.jpg',
  },
  {
    title: 'Love',
    artist: 'Zoe',
    youtubeId: 'pZTDd2kvcw4',
    image:
      'https://lastfm-img.freetls.fastly.net/i/u/174s/d96c26522767ef547a2386def8b8db79.jpg',
  },
];
---

<Base title='favorites'>
  <ListCard
    label='FAVORITE ANIME'
    items={["jojo's bizarre adventure", 'houseki no kuni', 'hibike! euphonium']}
    footerText='more on anilist'
    footerUrl='https://anilist.co/user/ai77ee'
  />

  <ListCard
    label='FAVORITE BANDS'
    items={['the strokes', 'arctic monkeys', 'chilli beans.']}
    footerText='more on last.fm'
    footerUrl='https://www.last.fm/user/aiimeee'
  />

  <ListCard
    label='FAVORITE K-POP ARTISTS'
    items={[
      'WJSN',
      'tripleS',
      'Yena',
      'TWICE',
      'fromis_9',
      'RESCENE',
      'KiiiKiii',
      'IZONE',
      'LE SSERAFIM',
    ]}
  />

  <MiniPlayer songs={songs} />
</Base>

<style></style>
